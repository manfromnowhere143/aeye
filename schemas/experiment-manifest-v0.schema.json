{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aeye.invalid/schemas/experiment-manifest-v0.schema.json",
  "title": "Aeye isolated experiment manifest v0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "experiment_id",
    "title",
    "status",
    "question",
    "authorization",
    "frozen_inputs",
    "procedure",
    "acceptance",
    "failure",
    "known_bad_controls",
    "blocking_conditions",
    "result"
  ],
  "properties": {
    "schema_version": {"const": "aeye.experiment-manifest.v0"},
    "experiment_id": {"type": "string", "pattern": "^E-[0-9]{3}$"},
    "title": {"type": "string", "minLength": 1},
    "status": {"enum": ["proposed", "preregistered", "running", "blocked", "invalid", "null", "inconclusive", "failed", "supported", "contradicted", "replicated", "corrected", "retracted"]},
    "question": {"type": "string", "minLength": 1},
    "authorization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "network_writes", "credentials", "private_data", "spending"],
      "properties": {
        "mode": {"const": "isolated_read_only"},
        "network_writes": {"const": false},
        "credentials": {"const": false},
        "private_data": {"const": false},
        "spending": {"const": false}
      }
    },
    "frozen_inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["input_id", "value", "status"],
        "properties": {
          "input_id": {"type": "string", "minLength": 1},
          "value": {},
          "status": {"enum": ["fixed", "unknown", "blocked"]}
        }
      }
    },
    "procedure": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "acceptance": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "failure": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "known_bad_controls": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "blocking_conditions": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "result": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "artifact_refs", "summary"],
          "properties": {
            "status": {"enum": ["invalid", "null", "inconclusive", "failed", "supported", "contradicted", "replicated", "corrected", "retracted"]},
            "artifact_refs": {
              "type": "array",
              "minItems": 1,
              "items": {"type": "string", "minLength": 1}
            },
            "summary": {"type": "string", "minLength": 1}
          }
        }
      ]
    }
  }
}
