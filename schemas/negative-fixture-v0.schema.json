{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aeye.invalid/schemas/negative-fixture-v0.schema.json",
  "title": "Aeye deterministic negative-fixture mutation v0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "base_kind", "base_path", "purpose", "mutations"],
  "properties": {
    "schema_version": {"const": "aeye.negative-fixture.v0"},
    "base_kind": {"enum": ["receipt", "report", "experiment"]},
    "base_path": {"type": "string", "minLength": 1},
    "purpose": {"type": "string", "minLength": 1},
    "mutations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["op", "pointer"],
        "properties": {
          "op": {"enum": ["set", "delete"]},
          "pointer": {"type": "string", "pattern": "^/"},
          "value": {}
        },
        "allOf": [
          {
            "if": {"properties": {"op": {"const": "set"}}},
            "then": {"required": ["value"]},
            "else": {"not": {"required": ["value"]}}
          }
        ]
      }
    }
  }
}
