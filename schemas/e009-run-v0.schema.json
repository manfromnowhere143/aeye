{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aeye.invalid/schemas/e009-run-v0.schema.json",
  "title": "Aeye E-009 provider run index v0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "experiment_id", "run_id", "input", "subject", "observations", "artifacts", "non_claims"],
  "properties": {
    "schema_version": {"const": "aeye.e009-run.v0"},
    "experiment_id": {"const": "E-009"},
    "run_id": {"const": "E-009-R1"},
    "input": {"$ref": "#/$defs/artifactWithoutSize"},
    "subject": {"$ref": "#/$defs/subject"},
    "observations": {
      "type": "object",
      "additionalProperties": false,
      "required": ["event_count", "coded_linear_event_count", "exact_event_count", "all_provider_coded_checks_accept", "output_token_id", "output_token", "conditional_union_bound"],
      "properties": {
        "event_count": {"const": 13},
        "coded_linear_event_count": {"const": 5},
        "exact_event_count": {"const": 8},
        "all_provider_coded_checks_accept": {"type": "boolean"},
        "output_token_id": {"type": "integer", "minimum": 0},
        "output_token": {"type": "string", "minLength": 1},
        "conditional_union_bound": {"$ref": "#/$defs/fraction"}
      }
    },
    "artifacts": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"$ref": "#/$defs/artifact"}
    },
    "non_claims": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "artifactWithoutSize": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/digest"}
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "bytes"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/digest"},
        "bytes": {"type": "integer", "minimum": 1}
      }
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["intent_id", "job_id", "request_root", "model_root", "execution_root", "demand_root", "trace_root", "output_root", "subject_root", "freshness_domain", "client_nonce"],
      "properties": {
        "intent_id": {"$ref": "#/$defs/digest"},
        "job_id": {"$ref": "#/$defs/digest"},
        "request_root": {"$ref": "#/$defs/digest"},
        "model_root": {"$ref": "#/$defs/digest"},
        "execution_root": {"$ref": "#/$defs/digest"},
        "demand_root": {"$ref": "#/$defs/digest"},
        "trace_root": {"$ref": "#/$defs/digest"},
        "output_root": {"$ref": "#/$defs/digest"},
        "subject_root": {"$ref": "#/$defs/digest"},
        "freshness_domain": {"type": "string", "minLength": 1},
        "client_nonce": {"type": "string", "pattern": "^[0-9a-f]{32,128}$"}
      }
    },
    "fraction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["numerator", "denominator"],
      "properties": {
        "numerator": {"type": "integer", "minimum": 0},
        "denominator": {"type": "integer", "minimum": 1}
      }
    }
  }
}
