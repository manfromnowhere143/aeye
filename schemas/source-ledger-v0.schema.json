{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aeye.invalid/schemas/source-ledger-v0.schema.json",
  "title": "Aeye source ledger v0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "cutoff_date", "verified_at", "entries"],
  "properties": {
    "schema_version": {"const": "aeye.source-ledger.v0"},
    "cutoff_date": {"type": "string", "format": "date"},
    "verified_at": {"type": "string", "format": "date-time"},
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/source"}
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "kind",
        "title",
        "authors",
        "version",
        "publication_date",
        "publication_date_status",
        "publication_date_precision",
        "retrieval_date",
        "url",
        "locator_status",
        "evidence_status",
        "claim_status",
        "scope",
        "limitations",
        "artifact"
      ],
      "properties": {
        "source_id": {"type": "string", "minLength": 1},
        "kind": {"enum": ["paper", "standard", "source_repository", "change_proposal", "whitepaper", "official_profile", "correspondence"]},
        "title": {"type": "string", "minLength": 1},
        "authors": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "version": {"type": "string", "minLength": 1},
        "publication_date": {
          "oneOf": [
            {"type": "string", "pattern": "^[0-9]{4}(-[0-9]{2}(-[0-9]{2})?)?$"},
            {"type": "null"}
          ]
        },
        "publication_date_status": {"enum": ["known", "unknown"]},
        "publication_date_precision": {"enum": ["day", "month", "year", "unknown"]},
        "retrieval_date": {"type": "string", "format": "date"},
        "url": {
          "oneOf": [
            {"type": "string", "format": "uri"},
            {"type": "null"}
          ]
        },
        "locator_status": {"enum": ["known", "unknown"]},
        "evidence_status": {"enum": ["retained", "metadata_only", "quarantined"]},
        "claim_status": {
          "enum": ["observed", "author_claim", "derived", "hypothesis", "proposed", "blocked", "falsified", "unknown"]
        },
        "scope": {"type": "string", "minLength": 1},
        "limitations": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "artifact": {
          "oneOf": [
            {"$ref": "#/$defs/fileArtifact"},
            {"$ref": "#/$defs/digestOnlyArtifact"},
            {"$ref": "#/$defs/gitArtifact"},
            {"$ref": "#/$defs/noArtifact"}
          ]
        }
      }
    },
    "fileArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "path", "sha256", "media_type", "retrieval_url"],
      "properties": {
        "type": {"const": "file"},
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/digest"},
        "media_type": {"type": "string", "minLength": 1},
        "retrieval_url": {"type": "string", "format": "uri"}
      }
    },
    "digestOnlyArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "path", "sha256", "media_type", "reason"],
      "properties": {
        "type": {"const": "digest_only"},
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/digest"},
        "media_type": {"type": "string", "minLength": 1},
        "reason": {"type": "string", "minLength": 1}
      }
    },
    "gitArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "path", "commit", "remote", "clean"],
      "properties": {
        "type": {"const": "git_tree"},
        "path": {"type": "string", "minLength": 1},
        "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "remote": {"type": "string", "format": "uri"},
        "clean": {"const": true}
      }
    },
    "noArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "reason"],
      "properties": {
        "type": {"const": "none"},
        "reason": {"type": "string", "minLength": 1}
      }
    }
  }
}
